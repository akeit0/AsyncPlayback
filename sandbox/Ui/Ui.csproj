<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-desktop</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UnoSingleProject>true</UnoSingleProject>
        <UnoGenerateHotReloadInfo>false</UnoGenerateHotReloadInfo>
        <UnoHotDesignLaunch>false</UnoHotDesignLaunch>
        <UnoDisableHotDesign>true</UnoDisableHotDesign>
        <UnoDisableMCPSupport>true</UnoDisableMCPSupport>

        <ApplicationTitle>AsyncPlayback Timeline</ApplicationTitle>
        <ApplicationId>com.asyncplayback.timeline</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationPublisher>AsyncPlayback</ApplicationPublisher>
        <Description>AsyncPlayback timeline sandbox powered by Uno Platform.</Description>

        <UnoFeatures>
      MVUX;
      SkiaRenderer;
    </UnoFeatures>
    </PropertyGroup>

    <ItemGroup>
        <UnoIcon Include="Assets\icon.svg" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference
            Include="Uno.WinUI.DevServer"
            Version="6.5.237"
            ExcludeAssets="all"
            PrivateAssets="all"
        />
        <ProjectReference Include="..\..\src\AsyncPlayback\AsyncPlayback.csproj" />
    </ItemGroup>
</Project>
