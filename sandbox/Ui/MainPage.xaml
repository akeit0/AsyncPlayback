<Page
    x:Class="Ui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ui"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
>
    <Grid Padding="18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="AsyncPlayback Timeline" FontSize="22" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Session.CompletionText}" />
                    <TextBlock Text="Time" Opacity="0.62" />
                    <TextBlock Text="{Binding Session.TimeText}" FontWeight="SemiBold" />
                    <TextBlock Text="Target" Opacity="0.62" />
                    <TextBlock Text="{Binding Session.TargetText}" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Run" Command="{Binding Run}" MinWidth="72" />
                <Button Content="Stop" Command="{Binding Stop}" MinWidth="72" />
                <Button Content="Start" Command="{Binding MoveToStart}" MinWidth="72" />
                <Button Content="End" Command="{Binding MoveToEnd}" MinWidth="72" />
                <Button Content="Reset" Command="{Binding Reset}" MinWidth="72" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Session.LabelText}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Session.TimeText}" FontSize="24" FontWeight="SemiBold" />
                <Grid Height="30" Width="450" HorizontalAlignment="Left" Background="#FFE8EAED">
                    <Rectangle
                        Width="{Binding Session.RectWidth}"
                        Fill="#FF3A9B6F"
                        HorizontalAlignment="Left"
                    />
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider
                    x:Name="TransportSlider"
                    Minimum="0"
                    Maximum="{Binding Session.ManualSliderMaximumSeconds}"
                    StepFrequency="0.01"
                    Value="{Binding Session.TimeSeconds, Mode=OneWay}"
                    ValueChanged="TransportSlider_OnValueChanged"
                />
                <TextBlock
                    Grid.Row="1"
                    Text="Timeline is generated from playback records and runtime events. Hover a bar or event row for details."
                    Opacity="0.62"
                    FontSize="12"
                />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Timeline" FontSize="16" FontWeight="SemiBold" />
                <ScrollViewer
                    Grid.Row="1"
                    Padding="8"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                >
                    <ItemsControl ItemsSource="{Binding Session.Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TimelineItem">
                                <Grid
                                    Height="36"
                                    Margin="0,0,0,6"
                                    ColumnSpacing="8"
                                    ToolTipService.ToolTip="{x:Bind Tooltip}"
                                >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Header}"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.76"
                                    />
                                    <Grid
                                        Grid.Column="1"
                                        Width="{x:Bind TrackWidth}"
                                        Height="30"
                                        Margin="0,1"
                                        Background="#FFF3F4F6"
                                    >
                                        <Border
                                            Margin="{x:Bind Margin}"
                                            Width="{x:Bind Width}"
                                            Height="18"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind Brush}"
                                            CornerRadius="3"
                                        />
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            Margin="{x:Bind Margin}"
                                            Padding="10,0,6,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#FF111827"
                                        />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Events" FontSize="16" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{Binding Session.Events}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PlaybackEventItem">
                            <Grid ToolTipService.ToolTip="{x:Bind Tooltip}" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{x:Bind Brush}"
                                    CornerRadius="2"
                                    Margin="0,2,0,2"
                                />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Text}"
                                    FontSize="12"
                                    TextWrapping="NoWrap"
                                    Margin="8,0,0,0"
                                />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
